+        case 'm': return Math.min(Math.max(getMinHeight(), Math.round(window.innerHeight * 0.6)), max);
+        case 'l': return Math.min(Math.max(getMinHeight(), Math.round(window.innerHeight * 0.8)), max);
+        case 'max': return max;
+        default: return 0;
+      }
+    };
