-  deploy:
-    needs: changes
-    if: needs.changes.outputs.convex == 'true'
-    runs-on: ubuntu-latest
-    timeout-minutes: 10
-    # Deliberately READ-ONLY (the workflow default). This job runs `npm ci`,
-    # whose dependency lifecycle scripts are third-party code, so it must never
