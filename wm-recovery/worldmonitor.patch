+
+.severity-btn {
+  padding: 3px 10px;
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: 0.05em;
+  color: var(--text-muted, #8b949e);
+  background: transparent;
+  border: 1px solid var(--border, rgba(255, 255, 255, 0.12));
